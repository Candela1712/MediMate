<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MediMate" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/medimate_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/medimate_primary_light</item>
        <item name="colorSurface">@color/medimate_surface</item>
        <item name="android:colorBackground">@color/medimate_background</item>
        <item name="colorError">@color/medimate_error</item>
        <item name="android:statusBarColor">@color/medimate_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Botó principal -->
    <style name="Widget.MediMate.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/medimate_primary</item>
    </style>

    <!-- Botó amb contorn -->
    <style name="Widget.MediMate.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/medimate_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/medimate_primary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- Camps de text -->
    <style name="Widget.MediMate.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/medimate_primary</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>

    <!-- Enllaços -->
    <style name="TextAppearance.MediMate.Link" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/medimate_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>